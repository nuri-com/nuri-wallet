yarn-error.*

# macOS
.DS_Store
*.pem

# Server mirrors (read-only snapshots)
server-mirror-secrets/
server-mirror/**/*.pem
server-mirror/**/*.key
server-mirror/**/.env*
server-mirror/**/secrets/*

# local env files
.env*.local

# typescript
*.tsbuildinfo
.taskmaster/
.claude/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
# Dependency directories
# Environment variables
.env
# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# OS specific

# Task files
# tasks.json
# tasks/

# MuSig2 server deprecated files
nuri-musig2-server/deprecated-unused-files/ 

# Workflow tool locks (local-only)
.wf/

# Local-only (do not sync)
local-only/

# Firebase service account key — this one IS a private key. It goes to EAS via
# `eas credentials` (FCM V1) and must never land in the repo. Firebase's default
# download name is <project>-firebase-adminsdk-<id>-<hash>.json.
*firebase-adminsdk*.json
*-service-account*.json

# Runtime state (do not commit)
data/events.ndjson
data/arkade-v4.sqlite*
apis/server-2fa/v3/data/
apis/server-2fa/v4/data/

# Experimental build artifacts and runtime state
experimental/wirex/selfhost/paymaster/out/
experimental/bitcoin/eps-selfhost/data/
