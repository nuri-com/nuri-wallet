{
  "name": "nuri-expo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clear": "expo start --clear",
    "config-plugins:build": "rm -rf config-plugins/build && tsc config-plugins/withMlKitDependencies.ts config-plugins/withNativeModules.ts config-plugins/withSumsub.ts --module commonjs --target es2020 --outDir config-plugins/build --esModuleInterop --skipLibCheck --moduleResolution node --types node",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "dev": "expo start --dev-client --lan",
    "expo:clear": "zsh scripts/run-expo.sh start --clear",
    "expo:start": "zsh scripts/run-expo.sh start",
    "assets:variants": "node scripts/generate-app-variant-assets.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "package:register": "node scripts/package-register.mjs",
    "wf": "node tools/wf.mjs",
    "lint": "biome check . && node scripts/check-no-dynamic-imports.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:web-integrity": "node --test scripts/web-integrity.test.mjs",
    "test:wf": "node --test tools/wf-regression.mjs tools/wf-pr-check.test.mjs",
    "check:cosigner-boundary": "bash scripts/check-no-legacy-cosigner.sh",
    "check": "npm run check:cosigner-boundary && npm run lint && npm run typecheck && npm run test && npm run test:web-integrity"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.4.74",
    "@arkade-os/swap": "0.0.20",
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/metro-runtime": "~5.0.5",
    "@expo/ngrok": "^4.1.0",
    "@noble/ciphers": "2.0.0",
    "@noble/curves": "2.0.0",
    "@noble/hashes": "2.0.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@scure/base": "2.0.0",
    "@scure/bip32": "^2.0.0",
    "@scure/btc-signer": "2.0.1",
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "@sumsub/react-native-mobilesdk-module": "^1.40.2",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/permissions": "^5.6.3",
    "@zerodev/sdk": "^5.5.7",
    "@zerodev/webauthn-key": "^5.5.0",
    "@zerodev/weighted-validator": "^5.5.1",
    "axios": "^1.18.0",
    "bech32": "^2.0.0",
    "buffer": "^6.0.3",
    "caip": "1.1.1",
    "ethers": "^6.15.0",
    "eu-payment-qr": "1.0.0",
    "events": "^3.3.0",
    "expo": "~53.0.27",
    "expo-application": "~6.1.5",
    "expo-build-properties": "^0.14.8",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-crypto": "^14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "^13.3.2",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-localization": "~16.1.6",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.5",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "expo-web-browser": "~14.2.0",
    "i18n-js": "^4.5.1",
    "light-bolt11-decoder": "3.2.0",
    "light-bolt12-decoder": "1.0.3",
    "nostr-tools": "^2.25.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^10.0.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "^15.12.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5",
    "text-encoding": "^0.7.0",
    "viem": "^2.37.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-transform-class-static-block": "^7.24.7",
    "@biomejs/biome": "^1.9.4",
    "@react-native-community/cli": "^13.6.9",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.0.10",
    "crypto-js": "^4.2.0",
    "jsqr": "^1.2.0",
    "patch-package": "^8.0.1",
    "pngjs": "^7.0.0",
    "ts-unused-exports": "^11.0.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.4"
  },
  "private": true,
  "overrides": {
    "postcss": "8.5.26",
    "@expo/fingerprint": "0.16.7",
    "ethjs-unit": {
      "bn.js": "4.12.5"
    },
    "number-to-bn": {
      "bn.js": "4.12.5"
    }
  },
  "volta": {
    "node": "22.21.1",
    "npm": "10.9.4"
  }
}
