# App faucet relay (public) — used by FaucetService
EXPO_PUBLIC_FAUCET_RELAY_URL="https://faucet.nuri.com"
EXPO_PUBLIC_FAUCET_RELAY_API_KEY="set-at-build-or-use-default"
EXPO_PUBLIC_FAUCET_ADDRESS="0xeD1a096951d63de7a7908f3082D30789E3464967"
EXPO_PUBLIC_WIREX_PROXY_URL="https://dev.nuri.com/tunnel/18791"
EXPO_PUBLIC_WIREX_PROXY_API_KEY="optional-if-server-requires-it"
EXPO_PUBLIC_WIREX_PROXY_BASIC_AUTH="dev:<shared-dev-token>"
EXPO_PUBLIC_WIREX_DEV_BASIC_AUTH="dev:<shared-dev-token>"
EXPO_PUBLIC_WIREX_SUMSUB_CLIENT_ID="optional-wirex-sumsub-client-id"
EXPO_PUBLIC_BTC_SELFHOST_DEBUG_API_BASE="http://127.0.0.1:3002/api"
EXPO_PUBLIC_ZERODEV_PROJECT_ID="optional-zerodev-project-id"
EXPO_PUBLIC_ZERODEV_API_KEY="optional-zerodev-api-key"

# Notification server override. Defaults to https://notifications.nuri.com in
# config/network.ts — only set this to point a dev build at a local server.
EXPO_PUBLIC_NOTIFICATIONS_API_URL=""

# Web Push override. The production VAPID public key is pinned in
# config/network.ts — set this only to point a local build at another keypair.
# NEVER put the private half here; it belongs on the notification server alone.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=""

# Android FCM config override. The committed ./google-services.json already
# covers every variant (one `client` entry per package name), so leave this
# empty unless you are pointing a local build at a different Firebase project.
GOOGLE_SERVICES_JSON=""
