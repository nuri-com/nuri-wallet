{
  // Nuri PWA edge worker — serves the Expo web build and recreates the
  // same-origin /api/* reverse proxy from the app.nuri.com nginx vhost.
  "name": "nuri-app-pwa",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "account_id": "f1b10562ebc61894a559e51b08e02262",

  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    // Worker handles /api/* first; all other unknown paths get the SPA shell.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  // Unique account namespace for the public LNURL forwarder. This enforces the
  // former nginx ceiling (approximately 10 requests per second per client).
  "ratelimits": [
    {
      "name": "LNURL_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 10 }
    }
  ],

  "routes": [{ "pattern": "app.nuri.com", "custom_domain": true }]
}
