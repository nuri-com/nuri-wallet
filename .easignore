# Ignore large/unnecessary local folders from EAS upload
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.expo/
.expo-shared/
.gradle/
.git/
.github/
.idea/
.vscode/
*.iml
.claude/
docs/
*.apk
*.aab
*.pem
!certs/certificate.pem

# Project-specific heavy or dev-only directories (anchor to repo root)
/server-*/
/swaps/
/server-backup-251010/
/.taskmaster/
/deprecated-old-files-not-in-use/
/deprecated/
/build-register/
/faucet/
/faucet-relay/
/js-monorepo/
/li-fi/
/nuri-server-prf-kms/
/secure-passkey/
/experimental/
/wirex/
local-only/

# Native build caches
/android
/ios
# Firebase service account keys are private keys. .gitignore keeps them out of
# git, but EAS reads .easignore, not .gitignore — without these the downloaded
# key would be uploaded with the build archive. google-services.json is NOT
# ignored here: the Android build needs it.
*firebase-adminsdk*.json
*-service-account*.json
